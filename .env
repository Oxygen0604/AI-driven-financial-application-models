CHATBOT_MODEL=deepseek-chat
DEEPSEEK_API_URL=https://api.deepseek.com
PYTHON_SCRIPT_PATH=C:/Users/liyiz/Desktop/AI-driven-financial-application-models-latest/AI chatbot/LLM.py//用你自己的根路径
